	"G": [".###.", "#...#", "#....", "#.###", "#...#", "#...#", ".####", ".....", "....."],
	"H": ["#...#", "#...#", "#...#", "#####", "#...#", "#...#", "#...#", ".....", "....."],
	"I": ["###", ".#.", ".#.", ".#.", ".#.", ".#.", "###", "...", "..."],
	"J": ["..###", "...#.", "...#.", "...#.", "#..#.", "#..#.", ".##..", ".....", "....."],
	"K": ["#...#", "#..#.", "#.#..", "##...", "#.#..", "#..#.", "#...#", ".....", "....."],
