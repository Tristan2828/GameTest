static var _font: FontFile = null


## The font (built once).
static func font() -> FontFile:
	if _font == null:
		_font = _build()
	return _font


## Make the pixel font the default for every UI element, everywhere.
static func install() -> void:
	var built := font()
	ThemeDB.fallback_font = built
	var project_theme := ThemeDB.get_project_theme()
	if project_theme != null:
		project_theme.default_font = built


static func _build() -> FontFile:
	var keys := GLYPHS.keys()
	var columns := 16
	var cell := Vector2i(8, HEIGHT + 1)
	var atlas := Image.create(columns * cell.x, (keys.size() / columns + 1) * cell.y, false, Image.FORMAT_RGBA8)
	var font_file := FontFile.new()
	font_file.fixed_size = HEIGHT
	font_file.fixed_size_scale_mode = TextServer.FIXED_SIZE_SCALE_INTEGER_ONLY
	var size := Vector2i(HEIGHT, 0)
	font_file.set_cache_ascent(0, HEIGHT, ASCENT)
	font_file.set_cache_descent(0, HEIGHT, HEIGHT - ASCENT)
	for index: int in keys.size():
		var character: String = keys[index]
		var rows: Array = GLYPHS[character]
		var width := String(rows[0]).length()
		var origin := Vector2i(index % columns, index / columns) * cell
		for y: int in rows.size():
			var row: String = rows[y]
			for x: int in width:
				if row[x] == "#":
					atlas.set_pixel(origin.x + x, origin.y + y, Color.WHITE)
		var code := character.unicode_at(0)
		font_file.set_glyph_advance(0, HEIGHT, code, Vector2(width + SPACING, 0))
		font_file.set_glyph_offset(0, size, code, Vector2(0, -ASCENT))
		font_file.set_glyph_size(0, size, code, Vector2(width, HEIGHT))
		font_file.set_glyph_uv_rect(0, size, code, Rect2(origin, Vector2(width, HEIGHT)))
		font_file.set_glyph_texture_idx(0, size, code, 0)
	font_file.set_texture_image(0, size, 0, atlas)
	return font_file
