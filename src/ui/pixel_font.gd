	"M": ["#...#", "##.##", "#.#.#", "#.#.#", "#...#", "#...#", "#...#", ".....", "....."],
	"N": ["#...#", "##..#", "#.#.#", "#..##", "#...#", "#...#", "#...#", ".....", "....."],
	"O": [".###.", "#...#", "#...#", "#...#", "#...#", "#...#", ".###.", ".....", "....."],
	"P": ["####.", "#...#", "#...#", "####.", "#....", "#....", "#....", ".....", "....."],
	"Q": [".###.", "#...#", "#...#", "#...#", "#.#.#", "#..#.", ".##.#", ".....", "....."],
	"R": ["####.", "#...#", "#...#", "####.", "#.#..", "#..#.", "#...#", ".....", "....."],
	"S": [".####", "#....", "#....", ".###.", "....#", "....#", "####.", ".....", "....."],
	"T": ["#####", "..#..", "..#..", "..#..", "..#..", "..#..", "..#..", ".....", "....."],
