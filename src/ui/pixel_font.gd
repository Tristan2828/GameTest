	"e": [".....", ".....", ".###.", "#...#", "#####", "#....", ".###.", ".....", "....."],
	"f": ["..##", ".#..", ".#..", "###.", ".#..", ".#..", ".#..", "....", "...."],
	"h": ["#....", "#....", "####.", "#...#", "#...#", "#...#", "#...#", ".....", "....."],
	"i": [".#.", "...", "##.", ".#.", ".#.", ".#.", "###", "...", "..."],
	"k": ["#...", "#...", "#..#", "#.#.", "##..", "#.#.", "#..#", "....", "...."],
	"l": ["##.", ".#.", ".#.", ".#.", ".#.", ".#.", "###", "...", "..."],
	"m": [".....", ".....", "##.#.", "#.#.#", "#.#.#", "#.#.#", "#...#", ".....", "....."],
	"n": [".....", ".....", "####.", "#...#", "#...#", "#...#", "#...#", ".....", "....."],
