	"W": ["#...#", "#...#", "#...#", "#.#.#", "#.#.#", "##.##", "#...#", ".....", "....."],
	"X": ["#...#", "#...#", ".#.#.", "..#..", ".#.#.", "#...#", "#...#", ".....", "....."],
	"Y": ["#...#", "#...#", ".#.#.", "..#..", "..#..", "..#..", "..#..", ".....", "....."],
	"Z": ["#####", "....#", "...#.", "..#..", ".#...", "#....", "#####", ".....", "....."],
	"a": [".....", ".....", ".###.", "....#", ".####", "#...#", ".####", ".....", "....."],
