class_name PixelFont
extends RefCounted
## The game's pixel font, drawn as text like the sprites: every printable ASCII
## character as a grid ("#" = pixel), 9 rows tall (7 above the baseline, 2 for
## descenders like g/j/p/q/y). Built into a bitmap FontFile at startup and set as
## the default UI font, so text stays perfectly crisp at every window size.
##
## Sizes: the font is 9px; Godot scales it to whole multiples (font size 9-13 =
## 1x, 14-22 = 2x, 23+ = 3x), so larger text stays pixel-perfect too.

const HEIGHT: int = 9
const ASCENT: int = 7
## Empty columns between letters.
const SPACING: int = 1

const GLYPHS: Dictionary[String, Array] = {
	" ": ["...", "...", "...", "...", "...", "...", "...", "...", "..."],
	"A": [".###.", "#...#", "#...#", "#####", "#...#", "#...#", "#...#", ".....", "....."],
