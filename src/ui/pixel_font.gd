	"\"": ["#.#", "#.#", "...", "...", "...", "...", "...", "...", "..."],
	"#": [".#.#.", "#####", ".#.#.", ".#.#.", ".#.#.", "#####", ".#.#.", ".....", "....."],
	"$": ["..#..", ".####", "#.#..", ".###.", "..#.#", "####.", "..#..", ".....", "....."],
	"%": ["##..#", "##.#.", "...#.", "..#..", ".#...", ".#.##", "#..##", ".....", "....."],
	"&": [".##..", "#..#.", "#.#..", ".#...", "#.#.#", "#..#.", ".##.#", ".....", "....."],
	"'": ["#", "#", ".", ".", ".", ".", ".", ".", "."],
	"(": [".#", "#.", "#.", "#.", "#.", "#.", ".#", "..", ".."],
	")": ["#.", ".#", ".#", ".#", ".#", ".#", "#.", "..", ".."],
	"*": [".....", "#.#.#", ".###.", "#####", ".###.", "#.#.#", ".....", ".....", "....."],
	"+": [".....", "..#..", "..#..", "#####", "..#..", "..#..", ".....", ".....", "....."],
	"-": ["....", "....", "....", "####", "....", "....", "....", "....", "...."],
	".": [".", ".", ".", ".", ".", ".", "#", ".", "."],
	"/": ["....#", "....#", "...#.", "..#..", ".#...", "#....", "#....", ".....", "....."],
	":": [".", ".", "#", ".", ".", "#", ".", ".", "."],
	"<": ["...#", "..#.", ".#..", "#...", ".#..", "..#.", "...#", "....", "...."],
	"=": ["....", "....", "####", "....", "####", "....", "....", "....", "...."],
	">": ["#...", ".#..", "..#.", "...#", "..#.", ".#..", "#...", "....", "...."],
	"?": [".###.", "#...#", "....#", "...#.", "..#..", ".....", "..#..", ".....", "....."],
	"@": [".###.", "#...#", "#.###", "#.#.#", "#.###", "#....", ".###.", ".....", "....."],
	"[": ["##", "#.", "#.", "#.", "#.", "#.", "##", "..", ".."],
	"\\": ["#....", "#....", ".#...", "..#..", "...#.", "....#", "....#", ".....", "....."],
	"]": ["##", ".#", ".#", ".#", ".#", ".#", "##", "..", ".."],
	"^": ["..#..", ".#.#.", "#...#", ".....", ".....", ".....", ".....", ".....", "....."],
	"`": ["#.", ".#", "..", "..", "..", "..", "..", "..", ".."],
	"{": ["..#", ".#.", ".#.", "#..", ".#.", ".#.", "..#", "...", "..."],
	"|": ["#", "#", "#", "#", "#", "#", "#", ".", "."],
	"}": ["#..", ".#.", ".#.", "..#", ".#.", ".#.", "#..", "...", "..."],
	"~": [".....", ".....", ".#...", "#.#.#", "...#.", ".....", ".....", ".....", "....."],
	",": [".", ".", ".", ".", ".", ".", "#", "#", "."],
	";": [".", ".", "#", ".", ".", "#", "#", ".", "."],
	"_": [".....", ".....", ".....", ".....", ".....", ".....", ".....", "#####", "....."],
